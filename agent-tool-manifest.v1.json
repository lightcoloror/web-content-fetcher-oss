{
  "schema_version": "agent-tool-manifest.v1",
  "id": "web-content-fetcher",
  "manifest_version": "1.0.0",
  "description": "Reusable compliant webpage fetching, extraction, and evidence archiving layer.",
  "capabilities": [
    "webpage_fetch",
    "structured_extraction",
    "evidence_archive",
    "attachment_conversion",
    "mcp_stdio"
  ],
  "interfaces": {
    "canonical": [
      {
        "kind": "python_module",
        "command": "python -m web_content_fetcher.cli fetch <url> --format json",
        "mode": "explicit_network_action"
      },
      {
        "kind": "python_module",
        "command": "python -m web_content_fetcher.cli doctor bridges",
        "mode": "read_only_local_doctor"
      }
    ],
    "windows_wrappers": [
      {
        "kind": "powershell_script",
        "command": "powershell -NoProfile -File scripts/start-web-ui.ps1",
        "mode": "explicit_start",
        "status": "optional_local_ui_not_runtime_verified"
      },
      {
        "kind": "batch_script",
        "command": "cmd /c scripts/start-web-ui.cmd",
        "mode": "explicit_start",
        "status": "optional_local_ui_not_runtime_verified"
      }
    ],
    "http": [],
    "mcp": [
      {
        "kind": "mcp",
        "command": "python -m web_content_fetcher.mcp_server",
        "transport": "stdio",
        "mode": "explicit_start"
      }
    ]
  },
  "inputs": [
    {
      "name": "url",
      "contract": "url.v1",
      "required": true
    },
    {
      "name": "authorized_browser_profile",
      "contract": "user-managed-browser-profile.v1",
      "required": false,
      "status": "explicit_opt_in_local_only"
    }
  ],
  "outputs": [
    {
      "name": "fetch_result",
      "contract": "web-content-fetcher.fetch-result.v1",
      "required": true
    },
    {
      "name": "archive_manifest",
      "contract": "material-manifest.v1",
      "required": false
    }
  ],
  "health": {
    "doctor": {
      "kind": "python_module",
      "command": "python -m web_content_fetcher.cli doctor bridges",
      "profile": "quick",
      "timeout_seconds": 20
    },
    "status_semantics": "Local package and optional bridge readiness only; it does not prove network reachability, authorization, or current online availability.",
    "proves_current_online": false
  },
  "platforms": [
    "windows",
    "linux",
    "macos"
  ],
  "requirements": {
    "network": {
      "mode": "conditional",
      "reason": "Fetching a URL requires network access. Loading this JSON metadata does not; the declared doctor is intended for local readiness, with transitive import effects not verified here."
    },
    "secrets": {
      "mode": "optional",
      "reason": "Public fetching needs no secret. Authenticated adapters require separately managed user credentials or profiles."
    },
    "approval": {
      "mode": "conditional",
      "reason": "Every external fetch requires applicable operator permission. Authenticated, private, browser-profile, or external archive actions require explicit user authorization; no automatic providers or backend model starts are permitted."
    }
  },
  "contract_refs": [
    {
      "contract_id": "material-manifest.v1",
